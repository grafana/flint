#!/usr/bin/env bash
#MISE description="Sign and verify the release Packslip manifest"

set -euo pipefail
# Resolve the checked-out tag, not github.sha (which can be the
# workflow branch on workflow_dispatch).
COMMIT=$(git rev-parse HEAD)
args=()
verify_args=()
provenance_url="${GITHUB_API_URL}/repos/${GITHUB_REPOSITORY}/attestations"
for archive in dist/flint-*.tar.gz dist/flint-*.zip; do
	verify_args+=(--artifact "$archive")
	digest=$(sha256sum "$archive" | cut -d' ' -f1)
	args+=(--provenance "${archive##*/}=${provenance_url}/sha256:${digest}")
done
packslip create \
	--project "github.com/${GITHUB_REPOSITORY}" \
	--version "${TAG#v}" --tag "$TAG" --commit "$COMMIT" \
	--source-repo "${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}" \
	--url-base "${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/releases/download/${TAG}" \
	--bin flint \
	--resource 'cli-spec/usage/flint=exec:flint usage' \
	--resource 'skill/flint=repo:skills/flint' \
	--out dist "${args[@]}" dist/flint-*.tar.gz dist/flint-*.zip
packslip verify dist/packslip.sigstore.json \
	--identity-prefix "${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/" \
	--issuer https://token.actions.githubusercontent.com "${verify_args[@]}"
